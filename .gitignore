# ==========================================
# Atelier B - Local Databases & Locks
# ==========================================
# Temporary project lock files and session databases
*.lock
*.db
*.tmp
*.log
bdp/*.pog
bdp/*.pog.db

# ==========================================
# Generated Proof & Status Files
# ==========================================
# Automatically generated Proof Obligations (POs) and status caches
# (Atelier B will regenerate these from .mch/.ref/.imp files)
bdp/*.po
bdp/*.po.db
bdp/*.bpo
bdp/*.bpo.db
bdp/*.bcomp
bdp/*.bint
bdp/*.bxml
bdp/*.btox

# Note: Do NOT ignore *.pmi or *.prm if you write manual proofs!

# ==========================================
# Generated Code Target Directories
# ==========================================
# C / C++ / Ada code generated by Atelier B translators
lang/
c/
ada/
cpp/
hd/

# ==========================================
# System & IDE Temporary Files
# ==========================================
.DS_Store
Thumbs.db
*.bak
